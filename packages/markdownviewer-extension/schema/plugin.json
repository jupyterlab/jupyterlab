{
  "jupyter.lab.setting-icon": "ui-components:markdown",
  "jupyter.lab.setting-icon-label": "Markdown Viewer",
  "jupyter.lab.transform": true,
  "title": "Markdown Viewer",
  "description": "Markdown viewer settings.",
  "jupyter.lab.menus": {
    "context": [
      {
        "command": "markdownviewer:copy",
        "selector": ".jp-MarkdownViewer",
        "rank": 0
      },
      {
        "command": "markdownviewer:edit",
        "selector": ".jp-MarkdownViewer"
      }
    ]
  },
  "definitions": {
    "fontFamily": {
      "type": ["string", "null"]
    },
    "fontSize": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100
    },
    "lineHeight": {
      "type": ["number", "null"]
    },
    "lineWidth": {
      "type": ["number", "null"]
    },
    "renderTimeout": {
      "type": "number"
    }
  },
  "properties": {
    "fontFamily": {
      "title": "Font Family",
      "description": "The font family used to render markdown.\nIf `null`, value from current theme is used.",
      "$ref": "#/definitions/fontFamily",
      "default": null
    },
    "fontSize": {
      "title": "Font Size",
      "description": "The size in pixel of the font used to render markdown.\nIf `null`, value from current theme is used.",
      "$ref": "#/definitions/fontSize",
      "default": null
    },
    "lineHeight": {
      "title": "Line Height",
      "description": "The line height used to render markdown.\nIf `null`, value from current theme is used.",
      "$ref": "#/definitions/lineHeight",
      "default": null
    },
    "lineWidth": {
      "title": "Line Width",
      "description": "The text line width expressed in CSS ch units.\nIf `null`, lines fit the viewport width.",
      "$ref": "#/definitions/lineWidth",
      "default": null
    },
    "hideFrontMatter": {
      "type": "boolean",
      "default": true
    },
    "frontMatter": {
      "title": "Front Matter",
      "description": "How to display YAML front matter. The opening line must be three dashes (---). The closing line must be three dashes (---) or three dots (...).",
      "type": "string",
      "oneOf": [
        { "const": "hide", "title": "Hide" },
        { "const": "markdown", "title": "Display as Markdown" },
        { "const": "raw", "title": "Display Raw" }
      ],
      "default": null
    },
    "renderTimeout": {
      "title": "Render Timeout",
      "description": "The render timeout in milliseconds.",
      "$ref": "#/definitions/renderTimeout",
      "default": 1000
    }
  },
  "patternProperties": {
    "^hideFrontMatter$": { "type": "boolean" }
  },
  "additionalProperties": false,
  "type": "object"
}
